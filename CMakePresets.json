{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "toolchainFile": "${sourceDir}/build/${presetName}/conan_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ProjectNestor_BUILD_TESTING": "ON",
        "ProjectNestor_ENABLE_SANITIZERS": "ON",
        "ProjectNestor_WARNINGS_AS_ERRORS": "OFF",
        "ProjectNestor_ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ProjectNestor_BUILD_TESTING": "ON",
        "ProjectNestor_WARNINGS_AS_ERRORS": "OFF",
        "ProjectNestor_ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ProjectNestor_BUILD_TESTING": "ON",
        "ProjectNestor_ENABLE_COVERAGE": "ON",
        "ProjectNestor_WARNINGS_AS_ERRORS": "OFF",
        "ProjectNestor_ENABLE_CLANG_TIDY": "OFF"
      }
    },
    {
      "name": "conan-debug",
      "displayName": "Conan Debug",
      "inherits": "debug"
    },
    {
      "name": "conan-release",
      "displayName": "Conan Release",
      "inherits": "release"
    },
    {
      "name": "ci",
      "displayName": "CI",
      "inherits": "release",
      "cacheVariables": {
        "ProjectNestor_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "docs",
      "displayName": "Docs (Doxygen)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ProjectNestor_BUILD_TESTING": "OFF",
        "ProjectNestor_ENABLE_DOXYGEN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "conan-debug",
      "configurePreset": "conan-debug"
    },
    {
      "name": "conan-release",
      "configurePreset": "conan-release"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "docs",
      "configurePreset": "docs",
      "targets": ["doxygen"]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
